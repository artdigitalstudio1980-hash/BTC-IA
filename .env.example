# BTC-AI — copia a .env y completa SOLO lo que uses. Nunca commitees .env
# Modos: ANALYST | ASSISTANT | AUTONOMOUS
APP_MODE=ANALYST
LIVE_TRADING=false

# Postgres (docker-compose lo usa)
DATABASE_URL=postgresql://btcai:btcai@postgres:5432/btcai

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK=llama3.1:8b

# Market
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
INTERVAL=1m
FEAR_GREED_URL=https://api.alternative.me/fng/?limit=1

# Binance (solo si ASSISTANT/AUTONOMOUS y LIVE_TRADING=true)
# Usa TESTNET por defecto (Paper). Para live, cambia BINANCE_BASE_URL y LIVE_TRADING=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision
# BINANCE_BASE_URL=https://api.binance.com

# Guardrails
MAX_POSITION_PCT=5
MAX_DAILY_LOSS_PCT=2
KILL_SWITCH_FILE=/tmp/btc-ai-kill

# Terraform (opcional)
# GITHUB_TOKEN=ghp_xxx  # solo si gestionas repo via terraform/modules/github-repo
# AWS_PROFILE=default
